    "@types/react-dom": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2"
  }
